<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/background_card"
        android:orientation="vertical"
        android:paddingVertical="@dimen/padding_extra_extra_large"
        android:paddingHorizontal="@dimen/_25sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elyby_login_username_hint" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/elyby_user"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textEmailAddress"
            android:textSize="@dimen/_14ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="@string/elyby_login_password_hint" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/elyby_pass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textSize="@dimen/_14ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="@string/elyby_login_totp_hint" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/elyby_totp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="number"
            android:textSize="@dimen/_14ssp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/elyby_login_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/login_online_login_label"
            android:textColor="@android:color/white" />
    </LinearLayout>
</FrameLayout>