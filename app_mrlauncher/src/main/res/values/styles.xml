<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MrLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorButtonNormal">@color/accent_blue_dark</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="dialogCornerRadius">0dp</item>
        <item name="android:seekBarStyle">@style/MrLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MrLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MrLauncher.Switch</item>
        <item name="switchStyle">@style/MrLauncher.Switch</item>
        <item name="buttonStyle">@style/MrLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MrLauncher.Button.Toggle</item>
    </style>

    <style name="MrLauncher.AppTheme" parent="MrLauncher"/>

    <style name="MrLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/minepb_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MrLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MrLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="MrLauncher.Button.Toggle" parent="MrLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="MrLauncher.Overlay.Green" parent="">
        <item name="colorPrimary">#2E9E5B</item>
        <item name="colorAccent">#2E9E5B</item>
        <item name="colorButtonNormal">#1B6B3B</item>
    </style>
    <style name="MrLauncher.Overlay.Red" parent="">
        <item name="colorPrimary">#E5484D</item>
        <item name="colorAccent">#E5484D</item>
        <item name="colorButtonNormal">#A32A30</item>
    </style>
    <style name="MrLauncher.Overlay.Purple" parent="">
        <item name="colorPrimary">#8E4EC6</item>
        <item name="colorAccent">#8E4EC6</item>
        <item name="colorButtonNormal">#5F2F8C</item>
    </style>
    <style name="MrLauncher.Overlay.Orange" parent="">
        <item name="colorPrimary">#F76B15</item>
        <item name="colorAccent">#F76B15</item>
        <item name="colorButtonNormal">#B54A0B</item>
    </style>
</resources>
